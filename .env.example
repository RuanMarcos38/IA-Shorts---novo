# Copie para .env.local. Não compartilhe nem publique as chaves.
GEMINI_API_KEY=
FAL_KEY=
GROQ_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
FAL_IMAGE_MODEL=fal-ai/flux/schnell
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Opcional; usa o FFmpeg instalado como dependência quando vazio.
FFMPEG_PATH=
# Mapeamentos aproximados; as vozes privadas do original não são conhecidas.
VOICE_RAFAEL=Algenib
VOICE_HEITOR=Enceladus
VOICE_VICENTE=Charon
VOICE_BIANCA=Kore
VOICE_CLARA=Aoede
